# Única configuración de ACP. Ejecutar python instalar.py para crear .env.
# Los valores iniciales permiten desarrollar SIN SQL Server.
ACP_ENTORNO=test
DB_SERVIDOR=offline-test
DB_NOMBRE=offline-test
DB_USUARIO=
DB_CLAVE=
DB_DRIVER=ACP_OFFLINE_NO_DATABASE

# instalar.py genera una clave local aleatoria; no compartir ni versionar .env.
ACP_JWT_SECRETO=
ACP_JWT_TTL_MIN=480
ACP_JWT_ALGORITMO=HS256

ACP_HOST=127.0.0.1
ACP_PUERTO=8810
ACP_WORKERS=1
ACP_RELOAD=false
ACP_RUNNER_ACTIVO=false
ACP_CORS_ORIGENES=["http://localhost:3000","http://127.0.0.1:3000"]
ACP_LOG_NIVEL=INFO
ACP_LOG_FORMATO=texto
# ACP_ETL_DIR: omitir para usar ETL/ dentro de este proyecto.

# Con una BD preparada: configurar DB_*, ACP_ENTORNO=dev y ACP_RUNNER_ACTIVO=true.
# Usar el nombre real de un driver ODBC instalado. No ejecutar contra producción.
